{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "process",
            "command": "dotnet",
            "args": ["build", "${workspaceFolder}/VideoCombinerGUI.csproj", "/property:GenerateFullPaths=true"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test",
            "type": "process",
            "command": "dotnet",
            "args": ["test", "${workspaceFolder}/VideoCombinerGUI.sln"],
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": "$msCompile"
        }
    ]
}
