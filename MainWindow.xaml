<Window x:Class="VideoCombinerGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video Combiner" Height="400" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox x:Name="VideoListBox" Grid.Row="0" Margin="10" PreviewMouseLeftButtonDown="VideoListBox_PreviewMouseLeftButtonDown" 
                 DragOver="VideoListBox_DragOver" Drop="VideoListBox_DropReorder">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="↑" Width="30" Height="25" Margin="0,0,2,0" 
                                Click="MoveUpButton_Click" Tag="{Binding}" 
                                ToolTip="Move Up"/>
                        <Button Grid.Column="1" Content="↓" Width="30" Height="25" Margin="2,0,2,0" 
                                Click="MoveDownButton_Click" Tag="{Binding}" 
                                ToolTip="Move Down"/>
                        <Button Grid.Column="2" Content="✕" Width="30" Height="25" Margin="2,0,5,0" 
                                Click="RemoveButton_Click" Tag="{Binding}" 
                                ToolTip="Remove"/>
                        <TextBlock Grid.Column="3" Text="{Binding}" VerticalAlignment="Center" 
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="10">
            <TextBlock x:Name="ProcessingText" Text="Processing: 0%" HorizontalAlignment="Left" />
            <ProgressBar x:Name="LoadingProgressBar" Minimum="0" Maximum="100" Height="20" Margin="0,5,0,0" />
        </StackPanel>

        <Button x:Name="CombineButton" Content="Combine Videos" Grid.Row="2" Margin="10" Padding="10,5" />
    </Grid>
</Window>